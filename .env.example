# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (default tries gemini-flash-latest, then gemini-2.5-flash)
GEMINI_MODEL=

# Optional: Hunter.io (Option A for finding the person). Without it, named leaders come
# from Google Search and no email address is guessed.
HUNTER_API_KEY=

# Step 7: Resend. Without a verified domain, FROM must be onboarding@resend.dev and
# TO_EMAIL must be the email you signed up to Resend with.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
# The ONLY recipient. sendEmail() has no recipient parameter; it always uses this.
TO_EMAIL=
SENDER_NAME=Nawaz from Sprinto
